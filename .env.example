# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# H3 resolution for area grid (7 = ~0.5 km² cells, good for city-level analysis)
H3_RESOLUTION=8

# Overpass API endpoint (public, key is not required)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Azure Blob Storage (only needed when deploying)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=embeddings
AZURE_BLOB_NAME=embeddings.npz
